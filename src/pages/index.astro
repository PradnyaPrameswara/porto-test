---
import Layout from "@/layouts/main.astro"
import SiteFooter from "@/components/site-footer.astro"
import SiteHeader from "@/components/site-header.astro"
import { experience, expertise, projects } from "@/data/portfolio"
---

<Layout>
  <div class="portfolio-shell">
    <SiteHeader />

    <main id="main-content">
      <h1 class="sr-only">Anak Agung Gede Pradnya Prameswara — Fullstack Web Developer</h1>

      <div class="portfolio-intro">
        <p>
          I'm <strong>Pradnya Prameswara</strong>, a fullstack web developer at
          Widhi Asih Bali Export. I build responsive web applications and
          studied Informatics Education at Universitas Pendidikan Ganesha.
        </p>
      </div>

      <section class="portfolio-section" aria-labelledby="numbers-heading">
        <h2 id="numbers-heading" class="portfolio-section-heading">pradnya/numbers</h2>
        <dl class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-5 gap-y-0 text-[14px] leading-[20px]">
          <dt class="portfolio-muted">selected projects</dt>
          <dd class="text-right font-medium tabular-nums">03</dd>
          <dt class="portfolio-muted">professional / teaching roles</dt>
          <dd class="text-right font-medium tabular-nums">02</dd>
          <dt class="portfolio-muted">focus areas</dt>
          <dd class="text-right font-medium tabular-nums">{String(expertise.length).padStart(2, "0")}</dd>
          <dt class="portfolio-muted">graduated</dt>
          <dd class="text-right font-medium tabular-nums">2026</dd>
          <dt class="portfolio-muted">based in</dt>
          <dd class="text-right">Gianyar, Bali</dd>
        </dl>
      </section>

      <section class="portfolio-section portfolio-section--contact" aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="portfolio-section-heading">pradnya/contact</h2>
        <a class="portfolio-plain-button" href="mailto:agungpradnya7@gmail.com?subject=Portfolio%20inquiry">
          Get in touch
        </a>
        <p class="mt-2 text-[14px] leading-[20px] portfolio-muted">
          Open to fullstack, frontend, and backend opportunities.
        </p>
      </section>

      <section class="portfolio-section portfolio-section--work" aria-labelledby="work-heading">
        <h2 id="work-heading" class="sr-only">Selected projects</h2>
        <div>
          {projects.map((project) => (
            <article class="portfolio-project">
              <h3 class="text-[16px] leading-[24px]">
                <a href={`/projects/${project.slug}/`} aria-label={`Read about ${project.name}`}>
                  pradnya/{project.name.toLowerCase().replaceAll(" ", "-")}
                </a>
              </h3>
              <p class="portfolio-prose">{project.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="portfolio-section" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="portfolio-section-heading">pradnya/experience</h2>
        <dl class="space-y-4 text-[13px] leading-[1.65]">
          {experience.map((entry) => (
            <div>
              <dt class="font-medium">{entry.role}</dt>
              <dd class="portfolio-muted">{entry.company} · {entry.period}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="portfolio-section" aria-labelledby="stack-heading">
        <h2 id="stack-heading" class="portfolio-section-heading">pradnya/stack</h2>
        <dl class="space-y-3 text-[13px] leading-[1.65]">
          {expertise.map((group) => (
            <div>
              <dt class="font-medium">{group.name}</dt>
              <dd class="portfolio-muted">{group.items.join(" · ")}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="portfolio-section" aria-labelledby="education-heading">
        <h2 id="education-heading" class="portfolio-section-heading">pradnya/education</h2>
        <p class="text-[13px] font-medium">Universitas Pendidikan Ganesha</p>
        <p class="portfolio-muted text-[13px]">Informatics Education · 2022–2026</p>
        <p class="mt-2 portfolio-prose">
          Research on an LLM-based diagnostic assessment system for detecting
          students' initial abilities.
        </p>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
