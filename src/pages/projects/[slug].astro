---
import type { GetStaticPaths } from "astro"
import Layout from "@/layouts/main.astro"
import SiteFooter from "@/components/site-footer.astro"
import SiteHeader from "@/components/site-header.astro"
import { projects, type Project } from "@/data/portfolio"

export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths

const { project } = Astro.props as { project: Project }
---

<Layout title={`${project.name} — Pradnya Prameswara`} description={project.description}>
  <div class="portfolio-shell">
    <SiteHeader />
    <main class="mt-[48px]" id="main-content">
      <nav aria-label="Breadcrumb" class="text-[12px] text-[#777]">
        <a href="/#work-heading" class="underline underline-offset-4 hover:text-[#222]">← all projects</a>
      </nav>

      <article class="mt-10">
        <p class="text-[12px] font-medium text-[#777]">pradnya/projects / {project.slug}</p>
        <h1 class="mt-3 text-[clamp(2rem,5vw,3rem)] font-semibold leading-[1.12] tracking-[-.06em]">{project.name}</h1>
        <p class="mt-5 max-w-[580px] text-[15px] leading-[1.75] text-[#595959]">{project.description}</p>

        <dl class="mt-12 grid grid-cols-[minmax(0,125px)_minmax(0,1fr)] gap-x-5 gap-y-4 border-y border-[#eaeaea] py-6 text-[13px] leading-[1.65]">
          <dt class="text-[#777]">type</dt><dd>{project.category}</dd>
          <dt class="text-[#777]">role</dt><dd>{project.role}</dd>
          <dt class="text-[#777]">status</dt><dd>{project.status}</dd>
        </dl>

        <section class="portfolio-section" aria-labelledby="contribution-heading">
          <h2 id="contribution-heading" class="portfolio-section-heading">pradnya/contributions</h2>
          <ul class="list-disc space-y-3 pl-5 text-[14px] leading-[1.75] text-[#555] marker:text-[#999]">
            {project.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </section>

        <section class="portfolio-section" aria-labelledby="technology-heading">
          <h2 id="technology-heading" class="portfolio-section-heading">pradnya/technologies</h2>
          <p class="text-[14px] leading-[1.8]">{project.technologies.join(" · ")}</p>
        </section>
      </article>
    </main>
    <SiteFooter />
  </div>
</Layout>
